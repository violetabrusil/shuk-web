---
---
<section class="hero" id="top">
  <div class="hero-inner">
    <div>
      <div class="tagline-line">Smart Hub for Uplifting Knowledge</div>
      <h1>Convertir la complejidad en capacidad.</h1>
      <p class="lead">Diseñamos y construimos ecosistemas tecnológicos a la medida. Entregamos soluciones que apoyan a las empresas en su control, gestión y desarrollo, potenciándolas con consultoría estratégica desde el primer día.</p>
      <div class="hero-ctas">
        <a href="#contacto" class="btn btn-primary">
          Hablemos de tu proyecto
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </a>
        <a href="#que-hacemos" class="btn btn-ghost-dark">Ver qué hacemos</a>
      </div>
      <div class="hero-sub">TECNOLOGÍA QUE AMPLIFICA</div>
    </div>
    <div class="hero-visual" aria-hidden="true">
      <svg class="square-draw" viewBox="0 0 200 200" fill="none">
        <!-- Acto 1: trazo continuo -->
        <rect class="act1-rect" x="14" y="14" width="172" height="172" rx="30" stroke="var(--orange)" stroke-width="7" stroke-linecap="round" pathLength="100" style="stroke-dasharray:100; stroke-dashoffset:100;"/>
        <!-- Acto 2: esquinas tipo visor -->
        <path class="act2-corner corner-tl" d="M58 14 L14 14 L14 58" stroke="var(--orange)" stroke-width="7" stroke-linecap="round" stroke-linejoin="round"/>
        <path class="act2-corner corner-tr" d="M142 14 L186 14 L186 58" stroke="var(--orange)" stroke-width="7" stroke-linecap="round" stroke-linejoin="round"/>
        <path class="act2-corner corner-br" d="M186 142 L186 186 L142 186" stroke="var(--orange)" stroke-width="7" stroke-linecap="round" stroke-linejoin="round"/>
        <path class="act2-corner corner-bl" d="M14 142 L14 186 L58 186" stroke="var(--orange)" stroke-width="7" stroke-linecap="round" stroke-linejoin="round"/>
        <!-- Acto 3: bloques que se construyen (sentido horario) -->
        <g class="act3-blocks" fill="var(--orange)">
          <rect class="blk" style="--bd:0s"    x="20"    y="10.5" width="42" height="7" rx="3"/>
          <rect class="blk" style="--bd:.08s"  x="79"    y="10.5" width="42" height="7" rx="3"/>
          <rect class="blk" style="--bd:.16s"  x="138"   y="10.5" width="42" height="7" rx="3"/>
          <rect class="blk" style="--bd:.24s"  x="182.5" y="20"   width="7" height="42" rx="3"/>
          <rect class="blk" style="--bd:.32s"  x="182.5" y="79"   width="7" height="42" rx="3"/>
          <rect class="blk" style="--bd:.40s"  x="182.5" y="138"  width="7" height="42" rx="3"/>
          <rect class="blk" style="--bd:.48s"  x="138"   y="182.5" width="42" height="7" rx="3"/>
          <rect class="blk" style="--bd:.56s"  x="79"    y="182.5" width="42" height="7" rx="3"/>
          <rect class="blk" style="--bd:.64s"  x="20"    y="182.5" width="42" height="7" rx="3"/>
          <rect class="blk" style="--bd:.72s"  x="10.5"  y="138"  width="7" height="42" rx="3"/>
          <rect class="blk" style="--bd:.80s"  x="10.5"  y="79"   width="7" height="42" rx="3"/>
          <rect class="blk" style="--bd:.88s"  x="10.5"  y="20"   width="7" height="42" rx="3"/>
        </g>
      </svg>
      <div class="square-symbol"><img src="/images/symbol-on-orange.png" alt="" width="104" height="104"></div>
    </div>
  </div>
</section>
