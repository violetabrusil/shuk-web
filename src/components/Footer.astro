<script>
  const yearEl = document.getElementById("year") as HTMLElement;
  yearEl.textContent = String(new Date().getFullYear());

  document.getElementById("cookiePrefs")?.addEventListener("click", () => {
    document.getElementById("cookieBar")?.classList.add("show");
