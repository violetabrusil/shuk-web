<div
  class="cookie-bar"
  id="cookieBar"
  role="region"
  aria-label="Aviso de cookies"
>
  <p style="margin:0;">
    Usamos cookies propias y de terceros para mejorar tu experiencia y medir el
    tráfico del sitio. <a href="#" id="cookieInfo">Más información</a>.
  </p>
  <div class="cookie-actions">
    <button type="button" id="cookieReject">Rechazar</button>
    <button type="button" class="accept" id="cookieAccept">Aceptar</button>
  </div>
</div>

<script>
  const cookieBar = document.getElementById("cookieBar") as HTMLElement;
  const CONSENT_KEY = "shuk_cookie_consent";

  function activarAnalitica() {
    const script = document.createElement("script");
    script.async = true;
    script.src = "https://www.googletagmanager.com/gtag/js?id=G-CZR9T98CWQ";
    document.head.appendChild(script);

    (window as any).dataLayer = (window as any).dataLayer || [];
    function gtag(...args: any[]) {
      (window as any).dataLayer.push(args);
    }
    gtag("js", new Date());
    gtag("config", "G-CZR9T98CWQ");
  }

  const eleccionGuardada = localStorage.getItem(CONSENT_KEY);
  if (!eleccionGuardada) {
    setTimeout(() => cookieBar.classList.add("show"), 700);
  } else if (eleccionGuardada === "accepted") {
    activarAnalitica();
  }

  document.getElementById("cookieAccept")?.addEventListener("click", () => {
    localStorage.setItem(CONSENT_KEY, "accepted");
    cookieBar.classList.remove("show");
    activarAnalitica();
  });

  document.getElementById("cookieReject")?.addEventListener("click", () => {
    localStorage.setItem(CONSENT_KEY, "rejected");
    cookieBar.classList.remove("show");
  });
</script>
